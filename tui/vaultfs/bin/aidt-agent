#!/bin/sh
# aidt-agent — agent identity and capability registry for the AIDT agent vault.
#
#   aidt-agent register --id <id> --name <name> [--cli ...] [--endpoint ...]
#                       [--model ...] [--desc ...] [--capabilities a,b,c]
#   aidt-agent whoami
#   aidt-agent list
#   aidt-agent show <id>
#
# Cards live in agents/<id>.md and are regenerated on every deploy. Agent-owned
# notes live in agents/<id>.notes.md and are never overwritten.
set -eu
TOOL=aidt-agent
. "$(dirname "$0")/aidt-common.sh"

AGENTS="$VAULT/agents"
REGISTRY="$AGENTS/REGISTRY.md"

usage() {
	sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

rebuild_registry() {
	[ -f "$REGISTRY" ] || return 0
	body="$(mktemp)"
	printf '| Agent | Id | Capabilities | Endpoint | Registered |\n' >"$body"
	printf '| --- | --- | --- | --- | --- |\n' >>"$body"
	found=0
	for card in "$AGENTS"/*.md; do
		[ -f "$card" ] || continue
		case "$card" in
		*/REGISTRY.md | *.notes.md) continue ;;
		esac
		id="$(fm "$card" id)"
		[ -n "$id" ] || continue
		found=1
		caps="$(fmlist "$card" capabilities | tr '\n' ',' | sed -e 's/,$//' -e 's/,/, /g')"
		printf '| %s | `%s` | %s | %s | %s |\n' \
			"$(md_cell "$(fm "$card" name)")" \
			"$(md_cell "$id")" \
			"$(md_cell "${caps:-—}")" \
			"$(md_cell "$(fm "$card" endpoint)")" \
			"$(md_cell "$(fm "$card" registered)")" >>"$body"
	done
	[ "$found" = 1 ] || printf '| _none registered_ | | | | |\n' >>"$body"
	replace_block "$REGISTRY" "BEGIN AIDT-AGENT-TABLE" "END AIDT-AGENT-TABLE" "$body"
	rm -f "$body"
}

cmd_register() {
	id='' name='' cli='' endpoint='' model='' desc='' caps=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--id) id="${2:-}"; shift 2 ;;
		--name) name="${2:-}"; shift 2 ;;
		--cli) cli="${2:-}"; shift 2 ;;
		--endpoint) endpoint="${2:-}"; shift 2 ;;
		--model) model="${2:-}"; shift 2 ;;
		--desc) desc="${2:-}"; shift 2 ;;
		--capabilities) caps="${2:-}"; shift 2 ;;
		-h | --help) usage 0 ;;
		*) die "unknown flag: $1" ;;
		esac
	done
	[ -n "$name" ] || die "--name is required"
	[ -n "$id" ] || id="$(slug "$name")"
	[ -n "$id" ] || die "could not derive an id from --name"

	mkdir -p "$AGENTS"
	card="$AGENTS/$id.md"
	tmp="$card.tmp.$$"
	{
		printf -- '---\n'
		printf 'id: %s\n' "$id"
		printf 'name: %s\n' "$name"
		printf 'cli: %s\n' "$cli"
		printf 'endpoint: %s\n' "$endpoint"
		printf 'model: %s\n' "$model"
		printf 'host: %s\n' "$(hostname 2>/dev/null || echo unknown)"
		printf 'vault: %s\n' "$VAULT"
		printf 'registered: %s\n' "$(now_utc)"
		printf 'capabilities:\n'
		if [ -n "$caps" ]; then
			# Trailing newline matters: without it `read` drops the last item.
			printf '%s\n' "$caps" | tr ',' '\n' | while IFS= read -r c; do
				c="$(printf %s "$c" | sed -e 's/^[ \t]*//' -e 's/[ \t]*$//')"
				[ -n "$c" ] && printf '  - %s\n' "$c"
			done
		fi
		printf -- '---\n\n'
		printf '# %s\n\n' "$name"
		if [ -n "$desc" ]; then printf '%s\n\n' "$desc"; fi
		printf '> Generated by AIDT at deploy time. **Do not hand-edit** — this file is\n'
		printf '> rewritten on every redeploy. Put anything you learn about yourself in\n'
		printf '> `%s.notes.md`, which is yours and is never overwritten.\n\n' "$id"
		printf '## Reaching models\n\n'
		printf -- '- Launch: `%s`\n' "${cli:-unknown}"
		printf -- '- Endpoint: %s\n' "${endpoint:-unknown}"
		printf -- '- Default model: %s\n\n' "${model:-unknown}"
		printf 'See `skills/olla-pool/SKILL.md`. Always go through the gateway.\n\n'
		printf '## Working here\n\n'
		printf '1. Read `AGENTS.md` — it is the schema for this vault.\n'
		printf '2. `aidt-skill list` before installing anything.\n'
		printf '3. `aidt-task list --me` for work you are eligible to claim.\n'
	} >"$tmp"
	mv "$tmp" "$card"

	notes="$AGENTS/$id.notes.md"
	if [ ! -f "$notes" ]; then
		{
			printf '# %s — Notes\n\n' "$name"
			printf 'Yours. Never overwritten by AIDT. Record what you actually learn about\n'
			printf 'your capabilities on this host.\n\n'
			printf '## What I am good at here\n\n- \n\n'
			printf '## What I have tried and failed at\n\n- \n\n'
			printf '## Skills I own\n\n- \n'
		} >"$notes"
	fi

	rebuild_registry
	echo "registered $id -> agents/$id.md"
}

cmd_whoami() {
	id="${AIDT_AGENT_ID:-}"
	[ -n "$id" ] || die "AIDT_AGENT_ID is not set — cannot tell which agent you are.
Set it, or run: aidt-agent list"
	card="$AGENTS/$id.md"
	[ -f "$card" ] || die "not registered: no agents/$id.md
Run: aidt-agent register --id $id --name <Name>"
	cat "$card"
}

cmd_list() {
	found=0
	for card in "$AGENTS"/*.md; do
		[ -f "$card" ] || continue
		case "$card" in
		*/REGISTRY.md | *.notes.md) continue ;;
		esac
		id="$(fm "$card" id)"
		[ -n "$id" ] || continue
		found=1
		caps="$(fmlist "$card" capabilities | tr '\n' ',' | sed -e 's/,$//' -e 's/,/, /g')"
		printf '%-16s %-22s %s\n' "$id" "$(fm "$card" name)" "${caps:-(no capabilities)}"
	done
	[ "$found" = 1 ] || echo "no agents registered on this host"
}

cmd_show() {
	[ $# -ge 1 ] || die "usage: aidt-agent show <id>"
	card="$AGENTS/$1.md"
	[ -f "$card" ] || die "no such agent: $1"
	cat "$card"
	[ -f "$AGENTS/$1.notes.md" ] && { echo; echo "--- notes ---"; cat "$AGENTS/$1.notes.md"; }
	return 0
}

[ $# -ge 1 ] || usage 1
sub="$1"
shift
case "$sub" in
register) cmd_register "$@" ;;
whoami) cmd_whoami "$@" ;;
list) cmd_list "$@" ;;
show) cmd_show "$@" ;;
-h | --help | help) usage 0 ;;
*) die "unknown command: $sub (try --help)" ;;
esac
